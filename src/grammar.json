{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "cab",
  "rules": {
    "source_code": {
      "type": "SYMBOL",
      "name": "expression"
    },
    "comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "multiline_comment"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "#{1,2}[^\\n]*"
          },
          "named": true,
          "value": "singleline_comment"
        }
      ]
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "parenthesis"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_list"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "island"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "if_else"
        },
        {
          "type": "SYMBOL",
          "name": "if_is"
        }
      ]
    },
    "parenthesis": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expression"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "attribute_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expression"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "prefix_operation": {
      "type": "CHOICE",
      "members": []
    },
    "infix_operation": {
      "type": "CHOICE",
      "members": []
    },
    "suffix_operation": {
      "type": "CHOICE",
      "members": []
    },
    "interpolation": {
      "type": "SEQ",
      "members": [
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "\\("
          }
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": ")"
          }
        }
      ]
    },
    "path": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "(\\.?\\/|\\.\\.)(?:[\\p{L}\\p{N}.\\/_-]|\\\\[^(])*"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "interpolation"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PATTERN",
                    "value": "(?:[\\p{L}\\p{N}.\\/_-]|\\\\[^(])+"
                  }
                },
                "named": true,
                "value": "content"
              }
            ]
          }
        }
      ]
    },
    "identifier": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[\\p{L}_-][\\p{L}\\p{N}_'-]*"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "`"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "interpolation"
                  },
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "IMMEDIATE_TOKEN",
                      "content": {
                        "type": "PATTERN",
                        "value": "(?:\\\\(?:[^(])|[^\\\\`])+"
                      }
                    },
                    "named": true,
                    "value": "content"
                  }
                ]
              }
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": "`"
              }
            }
          ]
        }
      ]
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "interpolation"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PATTERN",
                    "value": "(?:\\\\(?:[^(])|[^\\\\\"])+"
                  }
                },
                "named": true,
                "value": "content"
              }
            ]
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "\""
          }
        }
      ]
    },
    "island": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "interpolation"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PATTERN",
                    "value": "(?:\\\\(?:[^(])|[^\\\\>])+"
                  }
                },
                "named": true,
                "value": "content"
              }
            ]
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": ">"
          }
        }
      ]
    },
    "number": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[0-9]+(?:\\.[0-9]+([eE][0-9]+)?)?"
        },
        {
          "type": "PATTERN",
          "value": "0b[01]+(?:\\.[01]+([eE][01]+)?)?"
        },
        {
          "type": "PATTERN",
          "value": "0o[0-7]+(?:\\.[0-7]+([eE][0-7]+)?)?"
        },
        {
          "type": "PATTERN",
          "value": "0x[0-9a-fA-F]+(?:\\.[0-9a-fA-F]+([eE][0-9a-fA-F]+)?)?"
        }
      ]
    },
    "if_else": {
      "type": "PREC_RIGHT",
      "value": 30,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "if"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "expression"
            },
            "named": true,
            "value": "condition"
          },
          {
            "type": "STRING",
            "value": "then"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "expression"
            },
            "named": true,
            "value": "true_expression"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "else"
                  },
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "PREC_RIGHT",
                      "value": 30,
                      "content": {
                        "type": "SYMBOL",
                        "name": "expression"
                      }
                    },
                    "named": true,
                    "value": "false_expression"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "if_is": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "if"
        },
        {
          "type": "FIELD",
          "name": "expression",
          "content": {
            "type": "SYMBOL",
            "name": "expression"
          }
        },
        {
          "type": "STRING",
          "value": "is"
        },
        {
          "type": "FIELD",
          "name": "match_expression",
          "content": {
            "type": "PREC",
            "value": 20,
            "content": {
              "type": "SYMBOL",
              "name": "expression"
            }
          }
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "multiline_comment"
    },
    {
      "type": "SYMBOL",
      "name": "error_senitel"
    }
  ],
  "inline": [],
  "supertypes": [
    "expression"
  ]
}
